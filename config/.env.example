# === Bot API (BotFather → /newbot) ===
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# === Куда бот отправляет архивы ===
OWNER_CHAT_ID=123456789

# === Бэкенд ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_API_BASE=http://localhost:8000

# Рабочая папка (временные файлы и загрузки)
WORK_DIR=/tmp/tde

# Pairing / agent
PAIRING_TTL_SECONDS=900
AGENT_TOKEN_TTL_SECONDS=14400

# Upload
UPLOAD_MAX_BYTES=4294967296    # 4 GB
CHUNK_MAX_BYTES=8388608         # 8 MB per chunk
BOT_MAX_DOC_BYTES=52428800      # 50 MB — лимит Bot API
TEMP_TTL_SECONDS=600

# Секрет HMAC — сгенерируй: openssl rand -hex 32
SESSION_SECRET=replace_with_random_hex_32_bytes

# === Frontend ===
NEXT_PUBLIC_API_BASE=http://localhost:8000
